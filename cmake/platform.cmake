# Apple builds are per SDK and architecture. Universal archives can be assembled
# from separately built slices; mixing architectures here breaks SIMD manifests.
set(WEBRTC_TARGET_CPU "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES _arch_count)
    if(NOT _arch_count EQUAL 1)
        message(FATAL_ERROR "Build one Apple architecture per directory; combine slices afterwards with lipo/XCFramework.")
    endif()
    set(WEBRTC_TARGET_CPU "${CMAKE_OSX_ARCHITECTURES}")
endif()
string(TOLOWER "${WEBRTC_TARGET_CPU}" WEBRTC_TARGET_CPU)
set(WEBRTC_ARCH_X64 OFF)
set(WEBRTC_ARCH_ARM64 OFF)
if(WEBRTC_TARGET_CPU MATCHES "^(amd64|x86_64)$")
    set(WEBRTC_ARCH_X64 ON)
elseif(WEBRTC_TARGET_CPU MATCHES "^(arm64|aarch64)$" AND (APPLE OR ANDROID))
    set(WEBRTC_ARCH_ARM64 ON)
else()
    message(FATAL_ERROR "Supported CPUs: Windows/Linux x64, Apple/Android x86_64 or arm64; got ${WEBRTC_TARGET_CPU}")
endif()
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "WebRTC CMake requires a 64-bit target")
endif()
if(NOT WIN32 AND NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin|iOS|Android)$")
    message(FATAL_ERROR "Supported platforms: Windows, Linux, macOS, iOS and Android")
endif()
if(ANDROID)
    if(NOT CMAKE_ANDROID_ARCH_ABI MATCHES "^(arm64-v8a|x86_64)$")
        message(FATAL_ERROR "Android supports arm64-v8a and x86_64 only")
    endif()
    # The NDK legacy toolchain uses CMAKE_SYSTEM_VERSION=1, independently of
    # minSdkVersion. CMake's native Android toolchain uses the API level there.
    set(WEBRTC_ANDROID_API "${CMAKE_SYSTEM_VERSION}")
    if(DEFINED ANDROID_PLATFORM_LEVEL)
        set(WEBRTC_ANDROID_API "${ANDROID_PLATFORM_LEVEL}")
    endif()
    if(WEBRTC_ANDROID_API LESS 24)
        message(FATAL_ERROR "Android CMake requires API 24+")
    endif()
endif()

if(MSVC)
    set(WEBRTC_COMPILE_OPTIONS /W3 /bigobj /utf-8 /MP8
        "$<$<COMPILE_LANGUAGE:CXX>:/permissive->")
    set(WEBRTC_AVX2_FLAGS /arch:AVX2)
else()
    set(WEBRTC_COMPILE_OPTIONS -Wall -fvisibility=hidden)
    if(WEBRTC_ARCH_X64)
        list(APPEND WEBRTC_COMPILE_OPTIONS -msse3)
        set(WEBRTC_AVX2_FLAGS -mavx2 -mfma)
    endif()
endif()
if(WIN32)
    set(WEBRTC_PLATFORM_DEFINITIONS WEBRTC_WIN WIN32_LEAN_AND_MEAN NOMINMAX)
    set(WEBRTC_PLATFORM_PRIVATE_DEFINITIONS _CRT_SECURE_NO_WARNINGS
        _USE_MATH_DEFINES _WIN32_WINNT=0x0A00 WINVER=0x0A00)
elseif(ANDROID)
    set(WEBRTC_PLATFORM_DEFINITIONS WEBRTC_POSIX WEBRTC_LINUX WEBRTC_ANDROID)
    if(WEBRTC_ARCH_ARM64)
        list(APPEND WEBRTC_PLATFORM_DEFINITIONS WEBRTC_ARCH_ARM64 WEBRTC_HAS_NEON)
    endif()
    set(WEBRTC_PLATFORM_PRIVATE_DEFINITIONS
        HAVE_PTHREAD HAVE_NETINET_IN_H HAVE_ARPA_INET_H HAVE_UNISTD_H SRTP_LINUX)
    message(STATUS "Android native core: inject an application AudioDeviceModule for device audio; Java/JNI SDK is not built")
elseif(APPLE)
    set(WEBRTC_PLATFORM_DEFINITIONS WEBRTC_POSIX WEBRTC_MAC)
    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        list(APPEND WEBRTC_PLATFORM_DEFINITIONS WEBRTC_IOS)
    endif()
    if(WEBRTC_ARCH_ARM64)
        list(APPEND WEBRTC_PLATFORM_DEFINITIONS WEBRTC_ARCH_ARM64 WEBRTC_HAS_NEON)
    endif()
    set(_frameworks Foundation AVFoundation AudioToolbox CoreAudio CoreFoundation)
    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        list(APPEND _frameworks UIKit)
    else()
        list(APPEND _frameworks AudioUnit CoreGraphics)
    endif()
    foreach(_framework IN LISTS _frameworks)
        find_library(WEBRTC_FRAMEWORK_${_framework} ${_framework} REQUIRED)
        list(APPEND WEBRTC_APPLE_FRAMEWORKS "${WEBRTC_FRAMEWORK_${_framework}}")
    endforeach()
else()
    set(WEBRTC_PLATFORM_DEFINITIONS WEBRTC_POSIX WEBRTC_LINUX)
    set(WEBRTC_PLATFORM_PRIVATE_DEFINITIONS WEBRTC_DUMMY_FILE_DEVICES
        _FILE_OFFSET_BITS=64 _LARGEFILE_SOURCE _LARGEFILE64_SOURCE
        HAVE_PTHREAD HAVE_NETINET_IN_H HAVE_ARPA_INET_H HAVE_UNISTD_H SRTP_LINUX)
endif()
message(STATUS "WebRTC target: ${CMAKE_SYSTEM_NAME}/${WEBRTC_TARGET_CPU}")
