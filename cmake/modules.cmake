include("${CMAKE_CURRENT_LIST_DIR}/platform_sources.cmake")
option(WEBRTC_BUILD_VIDEO_CAPTURE "Build the legacy native video capture module" ON)

function(webrtc_add_module name)
    set(sources ${ARGN})
    webrtc_select_platform_sources(${name} sources)
    list(TRANSFORM sources PREPEND "${WEBRTC_ROOT}/")
    list(REMOVE_DUPLICATES sources)
    if(NOT sources)
        return()
    endif()
    add_library(webrtc_${name}_objects OBJECT ${sources})
    target_link_libraries(webrtc_${name}_objects PRIVATE webrtc_dependencies)
    target_include_directories(webrtc_${name}_objects PRIVATE ${WEBRTC_INCLUDE_DIRS})
    target_compile_definitions(webrtc_${name}_objects PRIVATE
        ${WEBRTC_PRIVATE_DEFINITIONS} ${WEBRTC_PLATFORM_PRIVATE_DEFINITIONS})
    target_compile_options(webrtc_${name}_objects PRIVATE ${WEBRTC_COMPILE_OPTIONS})
    if(APPLE)
        target_include_directories(webrtc_${name}_objects PRIVATE
            "${WEBRTC_ROOT}/sdk/objc" "${WEBRTC_ROOT}/sdk/objc/base")
        target_compile_options(webrtc_${name}_objects PRIVATE
            "$<$<COMPILE_LANGUAGE:OBJC,OBJCXX>:-fobjc-arc>")
    endif()
    foreach(source IN LISTS sources)
        if(WEBRTC_ARCH_X64 AND source MATCHES "_avx2\\.cc$")
            set_source_files_properties("${source}" PROPERTIES COMPILE_OPTIONS "${WEBRTC_AVX2_FLAGS}")
        endif()
        if(WEBRTC_ARCH_X64 AND source MATCHES "/cpu_features\\.cc$")
            set_source_files_properties("${source}" PROPERTIES COMPILE_DEFINITIONS WEBRTC_ENABLE_AVX2)
        endif()
    endforeach()
    add_library(webrtc_${name} STATIC $<TARGET_OBJECTS:webrtc_${name}_objects>)
    add_library(WebRTC::${name} ALIAS webrtc_${name})
    target_link_libraries(webrtc_${name} PUBLIC webrtc_dependencies)
    set_target_properties(webrtc_${name} PROPERTIES
        ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/$<CONFIG>/modules")
    set_property(GLOBAL APPEND PROPERTY WEBRTC_MODULE_OBJECTS $<TARGET_OBJECTS:webrtc_${name}_objects>)
    set_property(GLOBAL APPEND PROPERTY WEBRTC_ALL_SOURCES ${sources})
    set_property(GLOBAL APPEND PROPERTY WEBRTC_MODULE_TARGETS webrtc_${name})
endfunction()

set_property(GLOBAL PROPERTY WEBRTC_MODULE_OBJECTS "")
set_property(GLOBAL PROPERTY WEBRTC_ALL_SOURCES "")
set_property(GLOBAL PROPERTY WEBRTC_MODULE_TARGETS "")
foreach(module api rtc_base system_wrappers common_audio common_video
        audio_coding audio_processing audio_device video_coding rtp_rtcp
        congestion_control net p2p logging media audio video call pc)
    add_subdirectory("${CMAKE_CURRENT_LIST_DIR}/modules/${module}" "modules/${module}")
endforeach()
if(WEBRTC_BUILD_VIDEO_CAPTURE)
    add_subdirectory("${CMAKE_CURRENT_LIST_DIR}/modules/video_capture" "modules/video_capture")
endif()
get_property(WEBRTC_MODULE_OBJECTS GLOBAL PROPERTY WEBRTC_MODULE_OBJECTS)
get_property(WEBRTC_ALL_SOURCES GLOBAL PROPERTY WEBRTC_ALL_SOURCES)
get_property(WEBRTC_MODULE_TARGETS GLOBAL PROPERTY WEBRTC_MODULE_TARGETS)
add_custom_target(webrtc_modules DEPENDS ${WEBRTC_MODULE_TARGETS})
